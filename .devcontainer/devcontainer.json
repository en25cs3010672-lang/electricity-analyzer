{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "electricity_analyzer_enhanced.py"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  "updateContentCommand": "if [ -f packages.txt ]; then sudo apt-get update && sudo xargs apt-get install -y < packages.txt; fi; if [ -f requirements.txt ]; then pip install -r requirements.txt; fi",

  "postAttachCommand": "streamlit run electricity_analyzer_enhanced.py --server.address=0.0.0.0 --server.port=8501 --server.enableCORS false --server.enableXsrfProtection false",

  "forwardPorts": [
    8501
  ],

  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  }
}
